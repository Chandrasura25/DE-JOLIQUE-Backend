{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["node_modules/swagger-ui-dist/**"]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.js" }],
  "regions": ["fra1"],
  "installCommand": "npm ci",
  "devCommand": "npm run dev",
  "crons": [{ "path": "/api/cron/expire-orders", "schedule": "0 3 * * *" }]
}
