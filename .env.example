# ---------------------------------------------------------------------------
# De-Jolique Enterprise API — copy to server/.env and fill in.
# Never commit server/.env. Everything here stays on the server.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Public URLs (no trailing slash). CLIENT_URL may be a comma-separated list of
# allowed storefront origins; the first one is used for payment redirects.
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ----- Supabase: database -------------------------------------------------
# Dashboard -> Connect -> "Session pooler" (or "Direct connection") URI.
# Local Supabase (npx supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# true for Supabase cloud; false for local `supabase start`
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# ----- Supabase: auth + storage --------------------------------------------
# Dashboard -> Project Settings -> API. Local: printed by `npx supabase start`.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Service role key: bypasses RLS. Server only — never put it in the client.
SUPABASE_SERVICE_ROLE_KEY=
# Tokens are verified with the project's JWKS; no JWT secret is needed.
# Session cookie SameSite: lax (default) | strict | none. Use none only when the
# storefront and API are on different sites (requires HTTPS).
AUTH_COOKIE_SAME_SITE=lax

# Number of reverse proxies in front of the API (e.g. 1 on Render/Railway/Heroku),
# needed for correct client IPs in rate limiting. 0 when running locally.
TRUST_PROXY=0

# Serve client/dist from this server (single-service deployment).
SERVE_CLIENT=false

# ----- Store settings -------------------------------------------------------
STORE_NAME=De-Jolique Enterprise
CURRENCY=NGN
# Flat delivery fee added to every order (0 = free delivery)
SHIPPING_FEE=0
LOW_STOCK_THRESHOLD=5
# Unpaid orders are cancelled after this many hours (0 disables)
PENDING_ORDER_TTL_HOURS=48
# Vercel only: a long random string. Vercel Cron sends it to /api/cron/expire-orders,
# which cancels abandoned unpaid orders once a day. Leave empty elsewhere.
CRON_SECRET=

# ----- Paystack (https://dashboard.paystack.com/#/settings/developers) ------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ----- Flutterwave (https://app.flutterwave.com/dashboard/settings/apis) ----
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Settings -> Webhooks -> "Secret hash": any long random string, same value here.
FLUTTERWAVE_WEBHOOK_HASH=

# ----- Product image storage: supabase | cloudinary | s3 | local -------------
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=product-images

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jolique/products

# AWS S3 or Cloudflare R2 (set S3_ENDPOINT for R2: https://<account-id>.r2.cloudflarestorage.com)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for the bucket, e.g. https://pub-xxxx.r2.dev or https://<bucket>.s3.amazonaws.com
S3_PUBLIC_URL=

# ----- Seeded admin (npm run seed) ------------------------------------------
# You will be forced to change this password on first login.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@jolique.com
ADMIN_PASSWORD=ChangeMe123!
